#!/bin/sh
# Build this repository, serve it, and photograph one route of it - so a role can
# look at the thing rather than at a drawing of the thing.
#
# Contract, fixed by the factory. A project may reimplement the whole of this
# file, and this one does - what may not change is the interface:
#
#   ./scripts/app-render <route> <out-dir>
#
#   - <route> is a path the served site answers on, `/` or `/about` or
#     `/index.html`. Not a file path on disk and not a full URL.
#   - writes <out-dir>/<slug>-wide.png and <out-dir>/<slug>-narrow.png, where
#     the slug comes from the route: `/` is `index`, `/a/b` is `a-b`
#   - exits 0 only when both files exist and are non-empty
#   - exits non-zero with a message naming what was missing otherwise
#
# The two widths are `design-render`'s two widths, so a built page and its mock
# are two pictures a person can put side by side.
#
# Fridgie's version (#7). `npm run build` writes a Worker bundle, not a folder a
# static server can serve, so this serves the Worker itself:
#
#   1. a fresh local D1 under .wrangler/, with migrations/ applied;
#   2. `wrangler dev` on 127.0.0.1, started with DEV_SESSION_SEEDING=1 on its
#      command line - the only place that flag is ever set;
#   3. each picture opens /dev/session?next=<route>, which signs in a local seed
#      user, loads the design spec's populated inventory the first time, and
#      redirects to <route>. That route answers 404 on any deployed Worker
#      (test/access.test.ts proves it).
#
# The browser: Chromium's headless_shell first. The full Chromium in the cloud
# image lays headless pages out at a 500 px minimum and crops to 375, so its
# "narrow" picture is a cut-off 500 px layout (docs/memory/designer.md, #6).
# APP_RENDER_BROWSER overrides the choice.

set -eu

WIDE_SIZE="1280,900"
NARROW_SIZE="375,812"
PORT="${APP_RENDER_PORT:-8765}"

usage() {
    echo "usage: $0 <route> <out-dir>" >&2
    exit 2
}

[ $# -eq 2 ] || usage

route=$1
out_dir=$2

case $route in
    /*) : ;;
    *)  route="/$route" ;;
esac

repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo"

# An absolute out-dir: Chromium resolves a relative screenshot path against its
# own working directory and writes nothing (docs/memory/designer.md).
mkdir -p "$out_dir"
out_dir=$(cd "$out_dir" && pwd)

if [ ! -d node_modules ]; then
    echo "app-render: installing with npm ci" >&2
    npm ci >&2
fi

# A short TMPDIR inside the repository: under a long one Chromium cannot create
# its sockets and silently writes no picture.
work="$repo/.wrangler/app-render.$$"
mkdir -p "$work/tmp"
export TMPDIR="$work/tmp"
export WRANGLER_SEND_METRICS=false

browser="${APP_RENDER_BROWSER:-}"
if [ -z "$browser" ]; then
    for candidate in /opt/pw-browsers/chromium_headless_shell-*/chrome-linux/headless_shell; do
        [ -x "$candidate" ] && browser=$candidate && break
    done
fi
if [ -z "$browser" ]; then
    for candidate in headless_shell chromium chromium-browser google-chrome google-chrome-stable chrome; do
        if command -v "$candidate" >/dev/null 2>&1; then
            browser=$candidate
            break
        fi
    done
fi
if [ -z "$browser" ]; then
    echo "app-render: no headless browser found." >&2
    echo "  Looked for: /opt/pw-browsers/chromium_headless_shell-*, headless_shell," >&2
    echo "              chromium, chromium-browser, google-chrome, chrome" >&2
    echo "  Set APP_RENDER_BROWSER to one." >&2
    exit 1
fi
case $browser in
    *headless_shell*) : ;;
    *) echo "app-render: warning: $browser is not headless_shell; the narrow picture may be a cropped 500 px layout." >&2 ;;
esac

server_pid=""
cleanup() {
    if [ -n "$server_pid" ]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    rm -rf "$work"
}
trap cleanup EXIT INT TERM

echo "app-render: applying migrations to a fresh local D1" >&2
npx wrangler d1 migrations apply DB --local --persist-to "$work/state" >"$work/migrate.log" 2>&1 || {
    echo "app-render: the migrations did not apply:" >&2
    cat "$work/migrate.log" >&2
    exit 1
}

echo "app-render: starting wrangler dev on 127.0.0.1:$PORT" >&2
npx wrangler dev --local --ip 127.0.0.1 --port "$PORT" --persist-to "$work/state" \
    --var DEV_SESSION_SEEDING:1 \
    --var COOKIE_SECRET:app-render-local-only-not-a-secret \
    --var GITHUB_CLIENT_ID:app-render \
    --var GITHUB_CLIENT_SECRET:app-render \
    >"$work/dev.log" 2>&1 &
server_pid=$!

# Wait for the Worker to answer rather than sleeping a guess: a picture of an
# error page is still a picture.
ready=""
i=0
while [ "$i" -lt 150 ]; do
    if curl -fsS -o /dev/null "http://127.0.0.1:$PORT/" 2>/dev/null; then
        ready=yes
        break
    fi
    kill -0 "$server_pid" 2>/dev/null || break
    i=$((i + 1))
    sleep 0.2
done
if [ -z "$ready" ]; then
    echo "app-render: wrangler dev did not answer on http://127.0.0.1:$PORT/" >&2
    cat "$work/dev.log" >&2
    exit 1
fi

# The route itself must answer once signed in, or the picture is of an error.
status=$(curl -sS -o /dev/null -w '%{http_code}' -L -c "$work/jar" -b "$work/jar" \
    "http://127.0.0.1:$PORT/dev/session?next=$route")
if [ "$status" != "200" ]; then
    echo "app-render: $route answered $status, not 200, after signing in." >&2
    exit 1
fi

slug=$(printf '%s' "${route#/}" | sed -e 's/[?#].*$//' -e 's#/*$##' -e 's/\.html$//' -e 's#/#-#g')
[ -n "$slug" ] || slug=index

shoot() {
    size=$1
    suffix=$2
    target="$out_dir/$slug-$suffix.png"
    rm -f "$target"
    "$browser" \
        --headless \
        --disable-gpu \
        --no-sandbox \
        --hide-scrollbars \
        --force-device-scale-factor=2 \
        --virtual-time-budget=3000 \
        --user-data-dir="$work/profile-$suffix" \
        --window-size="$size" \
        --screenshot="$target" \
        "http://127.0.0.1:$PORT/dev/session?next=$route" >"$work/browser-$suffix.log" 2>&1 || true

    # The browser's exit status is not evidence; the file is.
    if [ ! -s "$target" ]; then
        echo "app-render: $browser produced no picture at $target" >&2
        cat "$work/browser-$suffix.log" >&2
        exit 1
    fi
    echo "$target"
}

shoot "$WIDE_SIZE" wide
shoot "$NARROW_SIZE" narrow
